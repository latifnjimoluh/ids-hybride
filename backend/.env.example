# Copier en `.env` et adapter. Toutes les variables ont le préfixe SNORT_.

# Backend : "mock" (dev Windows) ou "linux" (vraie sonde Snort)
SNORT_BACKEND=mock

# --- Authentification (JWT) ---
# ⚠️ EN PRODUCTION : générer une clé aléatoire longue et changer les identifiants.
SNORT_SECRET_KEY=dev-secret-change-me-in-production
SNORT_TOKEN_EXPIRE_MINUTES=720
SNORT_ADMIN_USER=admin
SNORT_ADMIN_PASSWORD=admin

# --- Utilisé uniquement quand SNORT_BACKEND=linux ---
SNORT_SNORT_BINARY=/usr/local/bin/snort
SNORT_CONFIG_PATH=/usr/local/etc/snort/snort.lua
SNORT_RULES_PATH=/usr/local/etc/snort/rules/local.rules
SNORT_ALERT_JSON_PATH=/var/log/snort/alert_json.txt
SNORT_SERVICE_NAME=snort3
SNORT_INTERFACE=eth0
